# Número com código do país e DDD, só dígitos. Exemplo: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=5500000000000

# Mensagem inicial padrão (será codificada na URL)
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá, gostaria de agendar uma avaliação

# Opcional, rastreamento (deixar vazio no protótipo)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# URL pública do site, usada em metadados e Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
